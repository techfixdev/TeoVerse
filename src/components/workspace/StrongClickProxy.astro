---
/**
 * StrongClickProxy — event-delegation island for word-click wiring.
 *
 * Attaches ONE delegated click listener on the reading container
 * (`<main class="module-lectura">`). When a `[data-strong]` element is
 * clicked it reads `data-strong` (codigoStrong) and `data-palabra` (palabra)
 * from the element and calls `$senalStrong.set(...)`.
 *
 * Does NOT handle panel open/close — that is StrongPanel's responsibility.
 * Uses event delegation so a single listener covers the entire chapter,
 * no matter how many tokenized words are rendered.
 *
 * The script runs on parse (inline <script> bundled by Astro).
 * The listener is cleaned up on page unload to avoid leaks.
 */
---

<script>
  import { $senalStrong } from '@/stores/referencia';

  function attach() {
    const container = document.querySelector<HTMLElement>('main.module-lectura');
    if (!container) return;

    function handleClick(event: MouseEvent) {
      const target = (event.target as HTMLElement).closest('[data-strong]') as HTMLElement | null;
      if (!target) return;

      const codigoStrong = target.dataset.strong;
      const palabra = target.dataset.palabra ?? '';

      if (codigoStrong) {
        $senalStrong.set({ codigoStrong, palabra });
      }
    }

    container.addEventListener('click', handleClick);

    // Cleanup on page navigation / unload
    window.addEventListener('pagehide', () => {
      container.removeEventListener('click', handleClick);
    }, { once: true });
  }

  // Run after DOM is available
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attach, { once: true });
  } else {
    attach();
  }
</script>
