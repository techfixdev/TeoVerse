---
import { BookOpen, House, Search, ScrollText } from '@lucide/astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { listBibleLibrary } from '@/db/queries';

const library = await listBibleLibrary();
---

<MainLayout title="Ríos de Vida | Biblioteca bíblica">
  <main id="main-content" class="min-h-screen bg-slate-50 p-6 text-slate-950 dark:bg-slate-950 dark:text-slate-100">
    <section class="mx-auto max-w-5xl rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
      <nav class="flex flex-wrap gap-4 text-sm font-semibold text-brand-cianDark dark:text-brand-cianClaro" aria-label="Navegacion principal">
        <a class="inline-flex items-center gap-2 underline decoration-brand-cianClaro underline-offset-4" href="/">
          <House class="h-4 w-4" aria-hidden="true" />
          Inicio
        </a>
        <a class="inline-flex items-center gap-2 underline decoration-brand-cianClaro underline-offset-4" href="/buscar">
          <Search class="h-4 w-4" aria-hidden="true" />
          Buscar
        </a>
        <a class="inline-flex items-center gap-2 underline decoration-brand-cianClaro underline-offset-4" href="/atribuciones">
          <ScrollText class="h-4 w-4" aria-hidden="true" />
          Atribuciones
        </a>
      </nav>

      <header class="mt-8 border-b border-slate-200 pb-6 dark:border-slate-800">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-cianDark dark:text-brand-cianClaro">Biblioteca</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Biblia</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-300">
          Versiones, libros y capítulos disponibles para lectura estática. Cada enlace apunta a una página generada en build time.
        </p>
      </header>

      <div class="mt-8 grid gap-6">
        {library.map((version) => (
          <section class="rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950/60" aria-labelledby={`version-${version.slug}`}>
            <div class="flex items-center gap-3">
              <BookOpen class="h-5 w-5 text-brand-cianDark dark:text-brand-cianClaro" aria-hidden="true" />
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">{version.slug}</p>
                <h2 id={`version-${version.slug}`} class="text-xl font-bold">{version.nombre}</h2>
              </div>
            </div>

            <div class="mt-5 grid gap-4">
              {version.books.map((book) => (
                <article class="rounded-2xl bg-white p-4 ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800" aria-labelledby={`${version.slug}-${book.slug}`}>
                  <h3 id={`${version.slug}-${book.slug}`} class="font-bold">{book.nombre}</h3>
                  <ul class="mt-3 flex flex-wrap gap-2" aria-label={`Capítulos de ${book.nombre}`}>
                    {book.chapters.map((chapter) => (
                      <li>
                        <a class="inline-flex rounded-full border border-brand-cianClaro px-3 py-1 text-sm font-semibold text-brand-cianDark hover:bg-brand-cianClaro/20 dark:border-brand-cian/40 dark:text-brand-cianClaro dark:hover:bg-brand-cian/10" href={chapter.href}>
                          Capítulo {chapter.capitulo}
                        </a>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </main>
</MainLayout>
