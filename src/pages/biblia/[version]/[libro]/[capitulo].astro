---
import WorkspaceLayout from '@/layouts/WorkspaceLayout.astro';
import { getChapter, getChapterNavigation, listStaticChapterPaths } from '@/db/queries';

export async function getStaticPaths() {
  const paths = await listStaticChapterPaths();

  return paths.map((path) => ({ params: path }));
}

const { version, libro, capitulo } = Astro.params;
const chapter = await getChapter({ version: version!, libro: libro!, capitulo: Number(capitulo) });
const navigation = await getChapterNavigation({ version: version!, libro: libro!, capitulo: Number(capitulo) });

if (!chapter) {
  throw new Error(`No chapter found for ${version}/${libro}/${capitulo}.`);
}

if (!navigation) {
  throw new Error(`No chapter navigation found for ${version}/${libro}/${capitulo}.`);
}
---

{/* TODO: rename chapter.biblia.* → chapter.recurso.* once queries.ts compat shim is removed (follow-up PR) */}
<WorkspaceLayout
  title={`TeoVerse | ${chapter.biblia.slug.toUpperCase()} ${chapter.libro.nombre} ${chapter.capitulo}`}
  version={version}
  libro={libro}
  capitulo={capitulo}
>
  <article class="mx-auto max-w-3xl rounded-brand border border-brand-grisSuave/40 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-[#0E1A1F]">

    {/* Breadcrumb navigation */}
    <nav class="flex flex-wrap gap-4 text-sm font-semibold text-brand-cianDark" aria-label="Navegación de secciones">
      <a class="underline decoration-brand-cianClaro underline-offset-4 transition hover:text-brand-gris" href="/">Inicio</a>
      <a class="underline decoration-brand-cianClaro underline-offset-4 transition hover:text-brand-gris" href="/biblia">Biblioteca</a>
      <a class="underline decoration-brand-cianClaro underline-offset-4 transition hover:text-brand-gris" href="/buscar">Buscar</a>
      <a class="underline decoration-brand-cianClaro underline-offset-4 transition hover:text-brand-gris" href="/atribuciones">Atribuciones</a>
    </nav>

    {/* Version + book + chapter heading */}
    <p class="mt-6 text-sm font-medium uppercase tracking-[0.2em] text-brand-cianDark">{chapter.biblia.slug}</p>
    <h1 class="mt-2 text-3xl font-bold text-[color:var(--brand-text)]">{chapter.libro.nombre} {chapter.capitulo}</h1>
    <p class="mt-2 text-sm text-brand-gris" aria-current="page">Capítulo actual: {navigation.current.label}</p>

    {/* Chapter navigation */}
    <nav class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" aria-label="Navegación de capítulos">
      {navigation.previous ? (
        <a
          class="rounded-brand border border-brand-cianClaro px-4 py-2 text-sm font-semibold text-brand-cianDark transition hover:bg-brand-cianClaro/20 dark:border-brand-cian/30 dark:hover:bg-brand-cian/10"
          href={navigation.previous.href}
          rel="prev"
        >
          Anterior: {navigation.previous.label}
        </a>
      ) : (
        <span
          class="rounded-brand border border-brand-grisSuave/40 px-4 py-2 text-sm font-semibold text-brand-grisSuave"
          aria-disabled="true"
        >
          Sin capítulo anterior
        </span>
      )}
      {navigation.next ? (
        <a
          class="rounded-brand border border-brand-cianClaro px-4 py-2 text-sm font-semibold text-brand-cianDark transition hover:bg-brand-cianClaro/20 dark:border-brand-cian/30 dark:hover:bg-brand-cian/10"
          href={navigation.next.href}
          rel="next"
        >
          Siguiente: {navigation.next.label}
        </a>
      ) : (
        <span
          class="rounded-brand border border-brand-grisSuave/40 px-4 py-2 text-sm font-semibold text-brand-grisSuave"
          aria-disabled="true"
        >
          Sin capítulo siguiente
        </span>
      )}
    </nav>

    {/* Verse list — font-reading (Georgia) preserved for scripture readability.
        Verse li id="v{n}" anchors kept byte-stable for #v{n} deep links. */}
    <ol class="mt-6 space-y-5 font-reading text-lg leading-8 text-[color:var(--brand-text)]">
      {chapter.versiculos.map((versiculo) => (
        <li id={`v${versiculo.numero}`} class="grid grid-cols-[2rem_1fr] gap-3">
          <span class="pt-1 text-sm font-bold text-brand-cianDark">{versiculo.numero}</span>
          <span>{versiculo.texto}</span>
        </li>
      ))}
    </ol>

    {/* Attribution block */}
    <p class="mt-6 rounded-brand bg-brand-cianClaro/20 p-4 text-sm text-brand-gris dark:bg-brand-cian/10 dark:text-brand-grisSuave">
      Fuente: {chapter.biblia.nombre} ({chapter.biblia.slug}), {chapter.biblia.fuente}, licencia {chapter.biblia.licencia}.
      <a class="font-semibold underline decoration-brand-cianClaro underline-offset-4 hover:text-brand-cianDark transition" href="/atribuciones">Ver atribuciones</a>.
    </p>
  </article>
</WorkspaceLayout>
