---
import WorkspaceLayout from '@/layouts/WorkspaceLayout.astro';
import StrongClickProxy from '@/components/workspace/StrongClickProxy.astro';
import StrongPanel from '@/components/modules/StrongPanel.astro';
import { getChapter, getChapterNavigation, listStaticChapterPaths, listTokensForChapter, listTskForChapter } from '@/db/queries';
import type { ChapterToken, TskRefTarget } from '@/db/queries';

export async function getStaticPaths() {
  const paths = await listStaticChapterPaths();

  return paths.map((path) => ({ params: path }));
}

const { version, libro, capitulo } = Astro.params;
const chapter = await getChapter({ version: version!, libro: libro!, capitulo: Number(capitulo) });
const navigation = await getChapterNavigation({ version: version!, libro: libro!, capitulo: Number(capitulo) });

if (!chapter) {
  throw new Error(`No chapter found for ${version}/${libro}/${capitulo}.`);
}

if (!navigation) {
  throw new Error(`No chapter navigation found for ${version}/${libro}/${capitulo}.`);
}

// Build-time token fetch for tokenized verse rendering.
// Groups tokens by verse number in posicion order.
// INVARIANT: tokens joined by spaces in posicion order reconstruct versiculo.texto byte-for-byte.
const allTokens = await listTokensForChapter({ version: version!, libro: libro!, capitulo: Number(capitulo) });

// Group tokens by verse number — Map<versiculo, ChapterToken[]>
const tokensByVerse = new Map<number, ChapterToken[]>();
for (const token of allTokens) {
  let verseTokens = tokensByVerse.get(token.versiculo);
  if (!verseTokens) {
    verseTokens = [];
    tokensByVerse.set(token.versiculo, verseTokens);
  }
  verseTokens.push(token);
}

// Build-time TSK cross-reference query
const tskRows = await listTskForChapter(libro!, Number(capitulo));
const tskByVerse = new Map<number, TskRefTarget[]>();
for (const row of tskRows) {
  tskByVerse.set(row.versiculo, row.referencias);
}

// Verse-run grouping: consecutive verses with identical text (e.g. El Mensaje paragraph ranges)
// are collapsed into a single display block. Individual verse anchors (#v{n}) are preserved
// as hidden spans so deep links and TSK markers continue to work per-verse.
type VerseRun = {
  startVerse: number;
  endVerse: number;
  verseNumbers: number[];
  text: string;
  label: string;
  isMultiVerse: boolean;
  tskRefs: TskRefTarget[];
  tokens: ChapterToken[] | undefined;
};
const verseRuns: VerseRun[] = [];
for (const v of chapter.versiculos) {
  const prev = verseRuns[verseRuns.length - 1];
  if (prev && prev.text === v.texto) {
    prev.verseNumbers.push(v.numero);
    prev.endVerse = v.numero;
  } else {
    verseRuns.push({
      startVerse: v.numero,
      endVerse: v.numero,
      verseNumbers: [v.numero],
      text: v.texto,
      label: "",
      isMultiVerse: false,
      tskRefs: [],
      tokens: undefined,
    });
  }
}

// Post-process: compute labels, TSK unions, and token access for each run
for (const run of verseRuns) {
  run.isMultiVerse = run.startVerse !== run.endVerse;
  run.label = run.isMultiVerse
    ? `${run.startVerse}-${run.endVerse}`
    : String(run.startVerse);

  // Tokens: only single-verse runs have tokenized rendering
  run.tokens = run.isMultiVerse ? undefined : tokensByVerse.get(run.startVerse);

  // TSK: union references from all verses in the run (deduplicated)
  const seenRefs = new Set<string>();
  for (const vn of run.verseNumbers) {
    const refs = tskByVerse.get(vn);
    if (refs) {
      for (const ref of refs) {
        const key = `${ref.libro_slug}:${ref.capitulo}:${ref.versiculo_start}`;
        if (!seenRefs.has(key)) {
          seenRefs.add(key);
          run.tskRefs.push(ref);
        }
      }
    }
  }
}
---

{/* TODO: rename chapter.biblia.* → chapter.recurso.* once queries.ts compat shim is removed (follow-up PR) */}
<WorkspaceLayout
  title={`Ríos de Vida | ${chapter.biblia.slug.toUpperCase()} ${chapter.libro.nombre} ${chapter.capitulo}`}
  version={version}
  libro={libro}
  capitulo={capitulo}
>
  <article class="mx-auto max-w-3xl rounded-brand border border-brand-grisSuave/40 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-[#0E1A1F]">

    {/* Breadcrumb navigation */}
    <nav class="flex flex-wrap gap-4 text-sm font-semibold text-brand-cianDark" aria-label="Navegación de secciones">
      <a class="underline decoration-brand-cianClaro underline-offset-4 transition hover:text-brand-gris" href="/">Inicio</a>
      <a class="underline decoration-brand-cianClaro underline-offset-4 transition hover:text-brand-gris" href="/biblia">Biblioteca</a>
      <a class="underline decoration-brand-cianClaro underline-offset-4 transition hover:text-brand-gris" href="/#home-search">Buscar</a>
      <a class="underline decoration-brand-cianClaro underline-offset-4 transition hover:text-brand-gris" href="/atribuciones">Atribuciones</a>
    </nav>

    {/* Version + book + chapter heading */}
    <p class="mt-6 text-sm font-medium uppercase tracking-[0.2em] text-brand-cianDark">{chapter.biblia.slug}</p>
    <h1 class="mt-2 text-3xl font-bold text-[color:var(--brand-text)]">{chapter.libro.nombre} {chapter.capitulo}</h1>
    <p class="mt-2 text-sm text-brand-gris" aria-current="page">Capítulo actual: {navigation.current.label}</p>

    {/* Chapter navigation */}
    <nav class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" aria-label="Navegación de capítulos">
      {navigation.previous ? (
        <a
          class="rounded-brand border border-brand-cianClaro px-4 py-2 text-sm font-semibold text-brand-cianDark transition hover:bg-brand-cianClaro/20 dark:border-brand-cian/30 dark:hover:bg-brand-cian/10"
          href={navigation.previous.href}
          rel="prev"
        >
          Anterior: {navigation.previous.label}
        </a>
      ) : (
        /* button[disabled] propaga el estado a AT de forma nativa; span[aria-disabled] no */
        <button
          type="button"
          disabled
          class="rounded-brand border border-brand-grisSuave/40 px-4 py-2 text-sm font-semibold text-brand-grisSuave opacity-50 cursor-not-allowed"
        >
          Sin capítulo anterior
        </button>
      )}
      {navigation.next ? (
        <a
          class="rounded-brand border border-brand-cianClaro px-4 py-2 text-sm font-semibold text-brand-cianDark transition hover:bg-brand-cianClaro/20 dark:border-brand-cian/30 dark:hover:bg-brand-cian/10"
          href={navigation.next.href}
          rel="next"
        >
          Siguiente: {navigation.next.label}
        </a>
      ) : (
        <button
          type="button"
          disabled
          class="rounded-brand border border-brand-grisSuave/40 px-4 py-2 text-sm font-semibold text-brand-grisSuave opacity-50 cursor-not-allowed"
        >
          Sin capítulo siguiente
        </button>
      )}
    </nav>

    {/* Verse list — font-reading (Georgia) preserved for scripture readability.
        Verse li id="v{n}" anchors kept byte-stable for #v{n} deep links.
        Tokenized rendering: words with codigoStrong render as <button class="palabra-strong">
        for Strong lookup; untagged words render as plain <span>.
        Invariant: tokens joined by spaces in posicion order = versiculo.texto byte-for-byte. */}
    <ol class="mt-6 space-y-5 font-reading text-lg leading-8 text-[color:var(--brand-text)]">
      {verseRuns.map((run) => (
        <li
          id={run.isMultiVerse ? undefined : `v${run.startVerse}`}
          class="grid grid-cols-[auto_1fr] gap-3"
        >
          <span class="pt-1 text-sm font-bold text-brand-cianDark whitespace-nowrap">
            {run.label}
          </span>
          <span>
            {/* Hidden anchors for multi-verse runs (preserves #v{n} deep links).
                Single-verse runs use the li id as anchor. */}
            {run.isMultiVerse
              ? run.verseNumbers.map((vn) => (
                  <span id={`v${vn}`} class="sr-only" aria-hidden="true"></span>
                ))
              : null}

            {run.tokens && run.tokens.length > 0 ? (
              run.tokens.map((token, index) => (
                <>
                  {token.codigoStrong ? (
                    <button
                      class="palabra-strong"
                      type="button"
                      data-strong={token.codigoStrong}
                      data-palabra={token.palabra}
                      aria-label={`${token.palabra} — código Strong ${token.codigoStrong}`}
                    >{token.palabra}</button>
                  ) : (
                    <span>{token.palabra}</span>
                  )}
                  {index < run.tokens!.length - 1 ? ' ' : ''}
                </>
              ))
            ) : (
              run.text
            )}

            {/* TSK cross-reference superscript marker (union for verse runs) */}
            {run.tskRefs.length > 0 && (
              <button
                class="tsk-marker"
                type="button"
                data-tsk-refs={JSON.stringify(run.tskRefs)}
                aria-label={`${run.tskRefs.length} referencias cruzadas para ${chapter.libro.nombre} ${chapter.capitulo}:${run.label}`}
              >{run.tskRefs.length}</button>
            )}
          </span>
        </li>
      ))}
    </ol>

    {/* Attribution block */}
    <p class="mt-6 rounded-brand bg-brand-cianClaro/20 p-4 text-sm text-brand-gris dark:bg-brand-cian/10 dark:text-brand-grisSuave">
      Fuente: {chapter.biblia.nombre} ({chapter.biblia.slug}), {chapter.biblia.fuente}, licencia {chapter.biblia.licencia}.
      <a class="font-semibold underline decoration-brand-cianClaro underline-offset-4 hover:text-brand-cianDark transition" href="/atribuciones">Ver atribuciones</a>.
    </p>
  </article>

  {/* Strong panel islands — mounted in the panels slot.
      StrongClickProxy: event-delegation on .module-lectura; fires $senalStrong.
      StrongPanel: subscribes to $senalStrong; fetches lexicon JSON; renders panel. */}
  <Fragment slot="panels">
    <StrongClickProxy />
    <StrongPanel />
  </Fragment>
</WorkspaceLayout>
