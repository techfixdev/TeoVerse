---
import MainLayout from '@/layouts/MainLayout.astro';
import BibleSelector from '@/components/modules/BibleSelector.astro';
import { getDailyReadings } from '@/db/queries';

const hoy = new Date();
const nombreMes = hoy.toLocaleDateString('es-ES', { month: 'long' });
const diaNum = hoy.getDate();
const readings = await getDailyReadings();

const tituloDia = `${diaNum} de ${nombreMes}`;
---

<MainLayout title="Ríos de Vida | Estudio bíblico modular">
  <main id="main-content" class="min-h-screen bg-slate-100 p-4 text-slate-950 dark:bg-slate-950 dark:text-slate-100 sm:p-6">
    <section class="mx-auto grid max-w-3xl gap-4">
      <article class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-cianDark dark:text-brand-cianClaro">Ríos de Vida</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">Leé, buscá y prepará tu estudio bíblico sin ruido.</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-400">
          Elegí una versión, un libro y un capítulo para empezar a leer, o buscá una palabra, frase o referencia en toda la Biblia desde un solo lugar.
        </p>

        <div class="mt-8">
          <BibleSelector />
        </div>

        <form
          id="search-form"
          class="mt-6 grid gap-3"
          role="search"
          aria-label="Buscar en la Biblia"
        >
          <label class="sr-only" for="home-search">Buscar en la Biblia</label>
          <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
            <input
              id="home-search"
              name="q"
              class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none ring-brand-cian transition placeholder:text-slate-400 focus:ring-2 dark:border-slate-700 dark:bg-slate-950"
              type="search"
              autocomplete="off"
              placeholder="Juan 3:16, reino, justicia..."
            />
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-2xl bg-brand-cianDark px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-brand-cianDark/90 focus:outline-none focus:ring-2 focus:ring-brand-cian focus:ring-offset-2 dark:focus:ring-offset-slate-900"
            >
              Buscar
            </button>
          </div>

          <fieldset id="version-filters" class="flex flex-wrap gap-2">
            <legend class="sr-only">Versiones a incluir en la búsqueda</legend>
            <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium transition has-checked:border-brand-cianDark has-checked:bg-brand-cianDark has-checked:text-white dark:border-slate-700 dark:has-checked:border-brand-cianClaro dark:has-checked:bg-brand-cianClaro dark:has-checked:text-slate-950">
              <input type="checkbox" name="version" value="spapddpt" checked class="sr-only" /> PDPT
            </label>
            <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium transition has-checked:border-brand-cianDark has-checked:bg-brand-cianDark has-checked:text-white dark:border-slate-700 dark:has-checked:border-brand-cianClaro dark:has-checked:bg-brand-cianClaro dark:has-checked:text-slate-950">
              <input type="checkbox" name="version" value="sparvg" class="sr-only" /> RVG
            </label>
            <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium transition has-checked:border-brand-cianDark has-checked:bg-brand-cianDark has-checked:text-white dark:border-slate-700 dark:has-checked:border-brand-cianClaro dark:has-checked:bg-brand-cianClaro dark:has-checked:text-slate-950">
              <input type="checkbox" name="version" value="spaRV1909" class="sr-only" /> RVR1909
            </label>
            <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium transition has-checked:border-brand-cianDark has-checked:bg-brand-cianDark has-checked:text-white dark:border-slate-700 dark:has-checked:border-brand-cianClaro dark:has-checked:bg-brand-cianClaro dark:has-checked:text-slate-950">
              <input type="checkbox" name="version" value="mensaje" class="sr-only" /> MSG
            </label>
          </fieldset>
        </form>

        <div id="search-results-section" class="hidden mt-6" aria-live="polite">
          <p id="search-status" class="text-sm text-slate-500 dark:text-slate-400"></p>
          <ol id="search-results" class="mt-3 space-y-3"></ol>
        </div>

        {
          readings.length === 0 ? (
            <p class="mt-10 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">
              No hay lectura programada para hoy ({tituloDia}). Revisá el plan de lectura o elegí un libro manualmente.
            </p>
          ) : (
            readings.map((reading, idx) => {
              const rango = reading.capituloInicio === reading.capituloFin
                ? `${reading.capituloInicio}`
                : `${reading.capituloInicio}-${reading.capituloFin}`;
              return (
                <section class="mt-10 rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950/60" aria-label={`Lectura diaria: ${reading.libro.nombre} ${rango}`}>
                  <div class="flex flex-col gap-1 border-b border-slate-200 pb-4 dark:border-slate-800 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-cianDark dark:text-brand-cianClaro">
                        {idx === 0 ? `Lectura diaria — ${tituloDia}` : 'También hoy'}
                      </p>
                      <h2 class="mt-1 text-2xl font-bold">{reading.libro.nombre} {rango}</h2>
                    </div>
                    <p class="text-sm text-slate-500 dark:text-slate-400">{reading.biblia.nombre}</p>
                  </div>

                  <ol class="mt-5 space-y-4 font-reading text-lg leading-8 text-slate-800 dark:text-slate-200">
                    {reading.versiculos.slice(0, 8).map((versiculo) => (
                      <li class="grid grid-cols-[2rem_1fr] gap-3">
                        <span class="pt-1 text-sm font-bold text-brand-cianDark dark:text-brand-cianClaro">{versiculo.numero}</span>
                        <span>{versiculo.texto}</span>
                      </li>
                    ))}
                  </ol>
                </section>
              );
            })
          )
        }
      </article>
    </section>
  </main>

  <script>
    interface SearchResult {
      version: string;
      versionNombre: string;
      book: string;
      chapter: number;
      verse: number;
      text: string;
      href: string;
    }

    const form = document.getElementById('search-form') as HTMLFormElement | null;
    const input = document.getElementById('home-search') as HTMLInputElement | null;
    const statusEl = document.getElementById('search-status');
    const resultsEl = document.getElementById('search-results');
    const resultsSection = document.getElementById('search-results-section');

    let debounceTimer: ReturnType<typeof setTimeout> | null = null;

    function getSelectedVersions(): string {
      const checkboxes = form?.querySelectorAll<HTMLInputElement>('input[name="version"]:checked');
      if (!checkboxes) return '';
      return Array.from(checkboxes).map((cb) => cb.value).join(',');
    }

    async function doSearch(query: string) {
      if (!statusEl || !resultsEl || !resultsSection) return;

      const q = query.trim();
      if (q.length < 2) {
        resultsSection.classList.add('hidden');
        resultsEl.textContent = '';
        return;
      }

      const versiones = getSelectedVersions();
      const params = new URLSearchParams({ q, versiones });
      const url = `/buscar.json?${params.toString()}`;

      statusEl.textContent = 'Buscando...';
      resultsSection.classList.remove('hidden');

      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error(`Error ${response.status}`);

        const data = await response.json();
        const results: SearchResult[] = data.results ?? [];

        if (results.length === 0) {
          statusEl.textContent = `Sin resultados para "${q}".`;
        } else {
          statusEl.textContent = `${results.length} resultado${results.length === 1 ? '' : 's'} para "${q}":`;
        }

        resultsEl.textContent = '';
        for (const r of results) {
          const li = document.createElement('li');
          li.className = 'rounded-2xl border border-slate-200 p-4 dark:border-slate-800';

          const link = document.createElement('a');
          link.className = 'font-bold text-brand-cianDark underline decoration-brand-cianClaro underline-offset-4 dark:text-brand-cianClaro';
          link.href = r.href;
          link.textContent = `${r.book} ${r.chapter}:${r.verse} (${r.versionNombre})`;

          const text = document.createElement('p');
          text.className = 'mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300';
          text.textContent = r.text;

          li.append(link, text);
          resultsEl.append(li);
        }
      } catch (error) {
        console.error(error);
        statusEl.textContent = 'Error al buscar. Intentá de nuevo.';
      }
    }

    function handleInput() {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        if (input) doSearch(input.value);
      }, 300);
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (debounceTimer) clearTimeout(debounceTimer);
      if (input) doSearch(input.value);
    });

    input?.addEventListener('input', handleInput);

    // Re-search when version toggles change
    form?.querySelectorAll('input[name="version"]').forEach((cb) => {
      cb.addEventListener('change', () => {
        if (input && input.value.trim().length >= 2) doSearch(input.value);
      });
    });

    // Check for ?q= param on load (from shared links)
    {
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q && input) {
        input.value = q;
        doSearch(q);
      }
    }
  </script>
</MainLayout>
