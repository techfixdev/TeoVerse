---
import { BookOpen, Library, MessageSquareText, Search, ScrollText } from '@lucide/astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getHomeChapter } from '@/db/queries';

const chapter = await getHomeChapter();

if (!chapter) {
  throw new Error('No home chapter found for TeoVerse.');
}

const chapterHref = `/biblia/${chapter.biblia.slug}/${chapter.libro.slug}/${chapter.capitulo}`;
---

<MainLayout title="TeoVerse | Estudio bíblico modular">
  <main class="min-h-screen bg-slate-100 p-4 text-slate-950 dark:bg-slate-950 dark:text-slate-100 sm:p-6">
    <section class="mx-auto flex max-w-7xl flex-col gap-4">
      <header class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-indigo-600 dark:text-indigo-400">TeoVerse</p>
              <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Estudio bíblico abierto y modular</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
              Base inicial con {chapter.biblia.nombre} ({chapter.biblia.slug}), fuente eBible.org bajo CC BY 4.0.
            </p>
          </div>

          <form class="flex min-w-0 items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-950 lg:w-96">
            <Search class="h-5 w-5 text-slate-400" aria-hidden="true" />
            <label class="sr-only" for="search">Buscar en la Biblia</label>
            <input
              id="search"
              class="w-full bg-transparent text-sm outline-none placeholder:text-slate-400"
              type="search"
              placeholder="Buscar: Génesis 1, principio, luz..."
            />
          </form>
        </div>
      </header>

      <div class="grid gap-4 lg:grid-cols-[260px_minmax(0,1fr)_320px]">
        <aside class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
            <Library class="h-4 w-4" aria-hidden="true" />
            Biblioteca
          </div>
          <nav class="mt-5 space-y-4" aria-label="Libros y capitulos">
            <a class="block rounded-2xl bg-indigo-50 p-4 text-indigo-950 ring-1 ring-indigo-100 dark:bg-indigo-950/50 dark:text-indigo-100 dark:ring-indigo-900" href={chapterHref}>
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-300">AT</span>
              <span class="mt-1 block text-lg font-bold">{chapter.libro.nombre}</span>
              <span class="mt-3 inline-flex rounded-full bg-white px-3 py-1 text-sm text-slate-700 shadow-sm dark:bg-slate-900 dark:text-slate-200">Capítulo {chapter.capitulo}</span>
            </a>
            <div class="rounded-2xl border border-dashed border-slate-300 p-4 text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
              spaRV1909 queda reservado para comparación histórica futura; no se carga texto inicial.
            </div>
          </nav>
        </aside>

        <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-7">
          <div class="flex flex-col gap-2 border-b border-slate-200 pb-5 dark:border-slate-800 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">{chapter.biblia.slug}</p>
              <h2 class="mt-1 text-3xl font-bold">{chapter.libro.nombre} {chapter.capitulo}</h2>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400">{chapter.biblia.nombre}</p>
          </div>

          <ol class="mt-6 space-y-5 font-reading text-lg leading-8 text-slate-800 dark:text-slate-200">
            {chapter.versiculos.map((versiculo) => (
              <li class="grid grid-cols-[2rem_1fr] gap-3">
                <span class="pt-1 text-sm font-bold text-indigo-600 dark:text-indigo-400">{versiculo.numero}</span>
                <span>{versiculo.texto}</span>
              </li>
            ))}
          </ol>
        </article>

        <aside class="grid gap-4">
          <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
              <MessageSquareText class="h-4 w-4" aria-hidden="true" />
              Comentarios
            </div>
            <p class="mt-4 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Panel preparado para notas, comentarios y módulos de estudio. La base arranca sin datos demo.
            </p>
          </section>

          <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
              <ScrollText class="h-4 w-4" aria-hidden="true" />
              Diccionario
            </div>
            <dl class="mt-4 space-y-4 text-sm">
              <div>
                <dt class="font-bold text-slate-900 dark:text-slate-100">H7225 principio</dt>
                <dd class="mt-1 text-slate-600 dark:text-slate-400">Comienzo, primero o punto de origen.</dd>
              </div>
              <div>
                <dt class="font-bold text-slate-900 dark:text-slate-100">H430 Dios</dt>
                <dd class="mt-1 text-slate-600 dark:text-slate-400">Elohim; término hebreo usado para Dios en Génesis.</dd>
              </div>
            </dl>
          </section>

          <section class="rounded-3xl border border-indigo-200 bg-indigo-50 p-5 text-sm leading-6 text-indigo-950 dark:border-indigo-900 dark:bg-indigo-950/40 dark:text-indigo-100">
            <BookOpen class="h-5 w-5" aria-hidden="true" />
            <p class="mt-3 font-semibold">Atribución requerida</p>
            <p class="mt-1">{chapter.biblia.nombre}, eBible.org, licencia CC BY 4.0.</p>
            <a class="mt-3 inline-flex font-semibold underline decoration-indigo-300 underline-offset-4" href="/atribuciones">
              Ver atribuciones y licencias
            </a>
          </section>
        </aside>
      </div>
    </section>
  </main>
</MainLayout>
