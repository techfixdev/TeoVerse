---
import MainLayout from '@/layouts/MainLayout.astro';
import BibleSelector from '@/components/modules/BibleSelector.astro';
import { getDailyReadings, listBibliaVersions } from '@/db/queries';

const hoy = new Date();
const nombreMes = hoy.toLocaleDateString('es-ES', { month: 'long' });
const diaNum = hoy.getDate();
const readings = await getDailyReadings(); // spapddpt baseline — no-JS fallback
const bibliaVersions = await listBibliaVersions(); // DB-driven pills, no hardcoded slugs

const tituloDia = `${diaNum} de ${nombreMes}`;
---

<MainLayout title="Ríos de Vida | Estudio bíblico modular">
  <main id="main-content" class="min-h-screen bg-slate-100 p-4 text-slate-950 dark:bg-slate-950 dark:text-slate-100 sm:p-6">
    <section class="mx-auto grid max-w-3xl gap-4">
      <article class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-cianDark dark:text-brand-cianClaro">Ríos de Vida</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">Leé, buscá y prepará tu estudio bíblico sin ruido.</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-400">
          Elegí una versión, un libro y un capítulo para empezar a leer, o buscá una palabra, frase o referencia en toda la Biblia desde un solo lugar.
        </p>

        <div class="mt-8">
          <BibleSelector />
        </div>

        <form
          id="search-form"
          class="mt-6 grid gap-3"
          role="search"
          aria-label="Buscar en la Biblia"
        >
          <label class="sr-only" for="home-search">Buscar en la Biblia</label>
          <div class="grid gap-3 sm:grid-cols-[1fr_auto]">
            <input
              id="home-search"
              name="q"
              class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none ring-brand-cian transition placeholder:text-slate-400 focus:ring-2 dark:border-slate-700 dark:bg-slate-950"
              type="search"
              autocomplete="off"
              placeholder="Juan 3:16, reino, justicia..."
            />
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-2xl bg-brand-cianDark px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-brand-cianDark/90 focus:outline-none focus:ring-2 focus:ring-brand-cian focus:ring-offset-2 dark:focus:ring-offset-slate-900"
            >
              Buscar
            </button>
          </div>

          <fieldset id="version-filters" class="flex flex-wrap gap-2">
            <legend class="sr-only">Versiones a incluir en la búsqueda</legend>
            {bibliaVersions.map((v) => (
              <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-slate-300 px-3 py-1.5 text-xs font-medium transition has-checked:border-brand-cianDark has-checked:bg-brand-cianDark has-checked:text-white dark:border-slate-700 dark:has-checked:border-brand-cianClaro dark:has-checked:bg-brand-cianClaro dark:has-checked:text-slate-950">
                <input type="checkbox" name="version" value={v.slug} class="sr-only" />
                {v.nombre}
              </label>
            ))}
          </fieldset>
          <p class="text-xs text-slate-500 dark:text-slate-400">Podés elegir más de una versión para buscar.</p>
        </form>

        <div id="search-results-section" class="hidden mt-6" aria-live="polite">
          <p id="search-status" class="text-sm text-slate-500 dark:text-slate-400"></p>
          <ol id="search-results" class="mt-3 space-y-3"></ol>
        </div>

        {/* Daily readings — skeleton + client island (DRV-3, DRV-4) */}
        {/* The client island checks $selector.version and swaps to the user's version if needed. */}
        {/* The spapddpt baseline here serves as the no-JS fallback (DRV-4). */}
        <div data-daily-readings class="min-h-[20rem]">
          {/* Skeleton — shown while client fetch is in-flight (hidden by default, toggled by island) */}
          <div
            data-daily-readings-skeleton
            class="hidden mt-10 space-y-4"
            aria-hidden="true"
          >
            <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950/60">
              <div class="animate-pulse space-y-3">
                <div class="h-3 w-24 rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="h-6 w-48 rounded bg-slate-200 dark:bg-slate-700"></div>
                <div class="mt-4 space-y-3">
                  {Array.from({ length: 5 }).map(() => (
                    <div class="grid grid-cols-[2rem_1fr] gap-3">
                      <div class="mt-1 h-4 w-5 rounded bg-slate-200 dark:bg-slate-700"></div>
                      <div class="h-4 rounded bg-slate-200 dark:bg-slate-700"></div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          {/* spapddpt baseline content — the no-JS fallback and starting state */}
          <div data-daily-readings-content>
            {
              readings.length === 0 ? (
                <p class="mt-10 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">
                  No hay lectura programada para hoy ({tituloDia}). Revisá el plan de lectura o elegí un libro manualmente.
                </p>
              ) : (
                readings.map((reading, idx) => {
                  const rango = reading.capituloInicio === reading.capituloFin
                    ? `${reading.capituloInicio}`
                    : `${reading.capituloInicio}-${reading.capituloFin}`;
                  return (
                    <section class="mt-10 rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950/60" aria-label={`Lectura diaria: ${reading.libro.nombre} ${rango}`}>
                      <div class="flex flex-col gap-1 border-b border-slate-200 pb-4 dark:border-slate-800 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-cianDark dark:text-brand-cianClaro">
                            {idx === 0 ? `Lectura diaria — ${tituloDia}` : 'También hoy'}
                          </p>
                          <h2 class="mt-1 text-2xl font-bold">{reading.libro.nombre} {rango}</h2>
                        </div>
                        <p class="text-sm text-slate-500 dark:text-slate-400">{reading.biblia.nombre}</p>
                      </div>

                      <ol class="mt-5 space-y-4 font-reading text-lg leading-8 text-slate-800 dark:text-slate-200">
                        {reading.versiculos.slice(0, 8).map((versiculo) => (
                          <li class="grid grid-cols-[2rem_1fr] gap-3">
                            <span class="pt-1 text-sm font-bold text-brand-cianDark dark:text-brand-cianClaro">{versiculo.numero}</span>
                            <span>{versiculo.texto}</span>
                          </li>
                        ))}
                      </ol>
                    </section>
                  );
                })
              )
            }
          </div>
        </div>
      </article>
    </section>
  </main>

  <script>
    interface SearchResult {
      version: string;
      versionNombre: string;
      book: string;
      chapter: number;
      verse: number;
      text: string;
      href: string;
    }

    const form = document.getElementById('search-form') as HTMLFormElement | null;
    const input = document.getElementById('home-search') as HTMLInputElement | null;
    const statusEl = document.getElementById('search-status');
    const resultsEl = document.getElementById('search-results');
    const resultsSection = document.getElementById('search-results-section');

    let debounceTimer: ReturnType<typeof setTimeout> | null = null;

    function getSelectedVersions(): string {
      const checkboxes = form?.querySelectorAll<HTMLInputElement>('input[name="version"]:checked');
      if (!checkboxes) return '';
      return Array.from(checkboxes).map((cb) => cb.value).join(',');
    }

    async function doSearch(query: string) {
      if (!statusEl || !resultsEl || !resultsSection) return;

      const q = query.trim();
      if (q.length < 2) {
        resultsSection.classList.add('hidden');
        resultsEl.textContent = '';
        return;
      }

      const versiones = getSelectedVersions();
      const params = new URLSearchParams({ q, versiones });
      const url = `/buscar.json?${params.toString()}`;

      statusEl.textContent = 'Buscando...';
      resultsSection.classList.remove('hidden');

      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error(`Error ${response.status}`);

        const data = await response.json();
        const results: SearchResult[] = data.results ?? [];

        if (results.length === 0) {
          statusEl.textContent = `Sin resultados para "${q}".`;
        } else {
          statusEl.textContent = `${results.length} resultado${results.length === 1 ? '' : 's'} para "${q}":`;
        }

        resultsEl.textContent = '';
        for (const r of results) {
          const li = document.createElement('li');
          li.className = 'rounded-2xl border border-slate-200 p-4 dark:border-slate-800';

          const link = document.createElement('a');
          link.className = 'font-bold text-brand-cianDark underline decoration-brand-cianClaro underline-offset-4 dark:text-brand-cianClaro';
          link.href = r.href;
          link.textContent = `${r.book} ${r.chapter}:${r.verse} (${r.versionNombre})`;

          const text = document.createElement('p');
          text.className = 'mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300';
          text.textContent = r.text;

          li.append(link, text);
          resultsEl.append(li);
        }
      } catch (error) {
        console.error(error);
        statusEl.textContent = 'Error al buscar. Intentá de nuevo.';
      }
    }

    function handleInput() {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        if (input) doSearch(input.value);
      }, 300);
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (debounceTimer) clearTimeout(debounceTimer);
      if (input) doSearch(input.value);
    });

    input?.addEventListener('input', handleInput);

    // Re-search when version toggles change
    form?.querySelectorAll('input[name="version"]').forEach((cb) => {
      cb.addEventListener('change', () => {
        if (input && input.value.trim().length >= 2) doSearch(input.value);
      });
    });

    // Check for ?q= param on load (from shared links)
    {
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q && input) {
        input.value = q;
        doSearch(q);
      }
    }
  </script>

  {/* T-8.3: Version pills pre-check island */}
  {/* Reads $selector.version and checks the matching pill. */}
  {/* MUST NOT write to $selector.version — search-session scoped only. */}
  <script>
    import { $selector } from '@/stores/selector';

    function initPillsPrecheck() {
      const DEFAULT_VERSION = 'spapddpt';
      let savedVersion: string = DEFAULT_VERSION;
      try {
        const stored = $selector.get();
        if (stored && typeof stored.version === 'string' && stored.version.length > 0) {
          savedVersion = stored.version;
        }
      } catch {
        // localStorage unavailable — fall back to default
      }

      const checkboxes = document.querySelectorAll<HTMLInputElement>('#version-filters input[name="version"]');
      let matched = false;
      for (const cb of checkboxes) {
        if (cb.value === savedVersion) {
          cb.checked = true;
          matched = true;
        } else {
          cb.checked = false;
        }
      }
      // If the saved version wasn't found in the pill list, fall back to spapddpt
      if (!matched) {
        const fallback = document.querySelector<HTMLInputElement>(`#version-filters input[value="${DEFAULT_VERSION}"]`);
        if (fallback) fallback.checked = true;
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPillsPrecheck, { once: true });
    } else {
      initPillsPrecheck();
    }
  </script>

  {/* T-7.3: Daily readings client island */}
  {/* Reads $selector.version; if different from 'spapddpt', shows skeleton and */}
  {/* fetches /datos/lectura-diaria.json?version=X, then swaps content in place. */}
  <script>
    import { $selector } from '@/stores/selector';

    interface DailyVersiculo {
      numero: number;
      texto: string;
    }

    interface DailyReadingEntry {
      biblia: { slug: string; nombre: string; licencia: string; fuente: string };
      libro: { slug: string; nombre: string };
      capituloInicio: number;
      capituloFin: number;
      versiculos: DailyVersiculo[];
    }

    interface DailyReadingsResponse {
      version: string;
      readings: DailyReadingEntry[];
    }

    function buildReadingsHTML(readings: DailyReadingEntry[], tituloDia: string): string {
      if (readings.length === 0) {
        return `<p class="mt-10 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">
          No hay lectura programada para hoy (${tituloDia}). Revisá el plan de lectura o elegí un libro manualmente.
        </p>`;
      }

      return readings
        .map((reading, idx) => {
          const rango =
            reading.capituloInicio === reading.capituloFin
              ? `${reading.capituloInicio}`
              : `${reading.capituloInicio}-${reading.capituloFin}`;

          const versiculosHTML = reading.versiculos
            .slice(0, 8)
            .map(
              (v) =>
                `<li class="grid grid-cols-[2rem_1fr] gap-3">
                  <span class="pt-1 text-sm font-bold text-brand-cianDark dark:text-brand-cianClaro">${v.numero}</span>
                  <span>${escapeHtml(v.texto)}</span>
                </li>`,
            )
            .join('');

          const label = idx === 0 ? `Lectura diaria — ${tituloDia}` : 'También hoy';

          return `<section class="mt-10 rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950/60" aria-label="Lectura diaria: ${escapeHtml(reading.libro.nombre)} ${rango}">
            <div class="flex flex-col gap-1 border-b border-slate-200 pb-4 dark:border-slate-800 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-cianDark dark:text-brand-cianClaro">${label}</p>
                <h2 class="mt-1 text-2xl font-bold">${escapeHtml(reading.libro.nombre)} ${rango}</h2>
              </div>
              <p class="text-sm text-slate-500 dark:text-slate-400">${escapeHtml(reading.biblia.nombre)}</p>
            </div>
            <ol class="mt-5 space-y-4 font-reading text-lg leading-8 text-slate-800 dark:text-slate-200">
              ${versiculosHTML}
            </ol>
          </section>`;
        })
        .join('');
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    async function initDailyReadingsIsland() {
      const DEFAULT_VERSION = 'spapddpt';
      let savedVersion: string = DEFAULT_VERSION;
      try {
        const stored = $selector.get();
        if (stored && typeof stored.version === 'string' && stored.version.length > 0) {
          savedVersion = stored.version;
        }
      } catch {
        // localStorage unavailable — spapddpt baseline is already rendered
        return;
      }

      // If user's version matches the baseline, nothing to do — zero flash
      if (savedVersion === DEFAULT_VERSION) return;

      const container = document.querySelector<HTMLElement>('[data-daily-readings]');
      const skeleton = document.querySelector<HTMLElement>('[data-daily-readings-skeleton]');
      const content = document.querySelector<HTMLElement>('[data-daily-readings-content]');
      if (!container || !skeleton || !content) return;

      // Get the date label that was rendered server-side
      const dateLabel = content.querySelector<HTMLElement>('p.text-xs')?.textContent?.split('—')[1]?.trim()
        ?? new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'long' });

      // Show skeleton, hide baseline content
      skeleton.classList.remove('hidden');
      content.classList.add('hidden');

      try {
        const response = await fetch(`/datos/lectura-diaria.json?version=${encodeURIComponent(savedVersion)}`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = (await response.json()) as DailyReadingsResponse;

        // Swap content
        content.innerHTML = buildReadingsHTML(data.readings, dateLabel);
        content.classList.remove('hidden');
      } catch (err) {
        console.error('DailyReadingsIsland: fetch failed, showing spapddpt baseline', err);
        // Restore spapddpt baseline on any error (DRV-4 graceful degradation)
        content.classList.remove('hidden');
      } finally {
        skeleton.classList.add('hidden');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDailyReadingsIsland, { once: true });
    } else {
      initDailyReadingsIsland();
    }
  </script>
</MainLayout>
