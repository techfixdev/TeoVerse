---
import { BookOpen, MessageSquareText, Search, ScrollText } from '@lucide/astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getHomeChapter } from '@/db/queries';

const chapter = await getHomeChapter();

if (!chapter) {
  throw new Error('No home chapter found for Ríos de Vida.');
}

const chapterHref = `/biblia/${chapter.biblia.slug}/${chapter.libro.slug}/${chapter.capitulo}`;
---

<MainLayout title="Ríos de Vida | Estudio bíblico modular">
  <main class="min-h-screen bg-slate-100 p-4 text-slate-950 dark:bg-slate-950 dark:text-slate-100 sm:p-6">
    <section class="mx-auto grid max-w-6xl gap-4 lg:grid-cols-[minmax(0,1fr)_340px]">
      <article class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-cianDark dark:text-brand-cianClaro">Ríos de Vida</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">Leé, buscá y prepará tu estudio bíblico sin ruido.</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-400">
          Wireframe inicial con la Biblia completa {chapter.biblia.nombre} ({chapter.biblia.slug}) generada en build time desde eBible.org.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a class="inline-flex justify-center rounded-2xl bg-brand-cian px-6 py-4 text-sm font-bold text-white shadow-sm transition hover:bg-brand-cian/90 focus:outline-none focus:ring-2 focus:ring-brand-cian focus:ring-offset-2 dark:focus:ring-offset-slate-900" href={chapterHref}>
            Empezar leyendo {chapter.libro.nombre} {chapter.capitulo}
          </a>
          <a class="inline-flex justify-center rounded-2xl px-4 py-3 text-sm font-semibold text-slate-600 underline decoration-slate-300 underline-offset-4 dark:text-slate-300 dark:decoration-slate-700" href="/buscar">
            Buscar una referencia
          </a>
        </div>

        <section class="mt-10 rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950/60" aria-label="Vista previa de lectura">
          <div class="flex flex-col gap-1 border-b border-slate-200 pb-4 dark:border-slate-800 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-cianDark dark:text-brand-cianClaro">Lectura inicial</p>
              <h2 class="mt-1 text-2xl font-bold">{chapter.libro.nombre} {chapter.capitulo}</h2>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400">{chapter.biblia.nombre}</p>
          </div>

          <ol class="mt-5 space-y-4 font-reading text-lg leading-8 text-slate-800 dark:text-slate-200">
            {chapter.versiculos.slice(0, 5).map((versiculo) => (
              <li class="grid grid-cols-[2rem_1fr] gap-3">
                <span class="pt-1 text-sm font-bold text-brand-cianDark dark:text-brand-cianClaro">{versiculo.numero}</span>
                <span>{versiculo.texto}</span>
              </li>
            ))}
          </ol>
        </section>
      </article>

      <aside class="grid gap-4 content-start">
        <form action="/buscar" class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900" role="search">
          <div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
            <Search class="h-4 w-4" aria-hidden="true" />
            Búsqueda
          </div>
          <label class="sr-only" for="search">Buscar en la Biblia</label>
          <input
            id="search"
            name="q"
            class="mt-4 w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none ring-brand-cian transition placeholder:text-slate-400 focus:ring-2 dark:border-slate-700 dark:bg-slate-950"
            type="search"
            placeholder="Juan 3:16, reino, justicia..."
          />
        </form>

        <section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
            <MessageSquareText class="h-4 w-4" aria-hidden="true" />
            Próximo panel
          </div>
          <p class="mt-4 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Comentarios, notas y módulos de estudio entran después. Hoy la prioridad es lectura clara y datos correctos.
          </p>
        </section>

        <section class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
            <ScrollText class="h-4 w-4" aria-hidden="true" />
            Diccionario futuro
          </div>
          <p class="mt-4 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Strong, léxicos y referencias cruzadas quedan como promesa de producto, no como navegación principal prematura.
          </p>
        </section>

        <section class="rounded-[2rem] border border-brand-cianClaro bg-brand-cianClaro/10 p-5 text-sm leading-6 text-slate-900 dark:border-brand-cian/30 dark:bg-brand-cian/10 dark:text-slate-100">
          <BookOpen class="h-5 w-5" aria-hidden="true" />
          <p class="mt-3 font-semibold">Atribución</p>
          <p class="mt-1">{chapter.biblia.nombre}, eBible.org, CC BY 4.0.</p>
          <a class="mt-3 inline-flex font-semibold underline decoration-brand-cianClaro underline-offset-4" href="/atribuciones">
            Ver licencias
          </a>
        </section>
      </aside>
    </section>
  </main>
</MainLayout>
