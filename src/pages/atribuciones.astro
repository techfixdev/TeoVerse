---
import { BookOpen, ExternalLink } from '@lucide/astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { listBibleAttributions } from '@/db/queries';

const attributions = await listBibleAttributions();
const sourceUrlPattern = /https?:\/\/\S+/;
---

<MainLayout title="Ríos de Vida | Atribuciones y licencias">
  <main id="main-content" class="min-h-screen bg-slate-50 p-6 text-slate-950 dark:bg-slate-950 dark:text-slate-100">
    <section class="mx-auto max-w-4xl rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
      <a class="text-sm font-semibold text-brand-cianDark underline decoration-brand-cianClaro underline-offset-4 dark:text-brand-cianClaro" href="/">
        Volver al inicio
      </a>

      <div class="mt-6 flex items-center gap-3">
        <BookOpen class="h-6 w-6 text-brand-cianDark dark:text-brand-cianClaro" aria-hidden="true" />
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-cianDark dark:text-brand-cianClaro">Atribuciones</p>
      </div>

      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Biblias y licencias</h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
        Ríos de Vida muestra las fuentes bíblicas con atribución visible. La lectura inicial usa Palabra de Dios para ti,
        provista por eBible.org bajo Creative Commons Attribution 4.0 International.
      </p>

      <div class="mt-8 grid gap-4">
        {attributions.map((attribution) => {
          const sourceUrl = attribution.fuente.match(sourceUrlPattern)?.[0];

          return (
            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-950">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-cianDark dark:text-brand-cianClaro">{attribution.slug}</p>
              <h2 class="mt-2 text-2xl font-bold">{attribution.nombre}</h2>
              <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2">
                <div>
                  <dt class="font-semibold text-slate-900 dark:text-slate-100">Idioma</dt>
                  <dd class="mt-1 text-slate-600 dark:text-slate-400">{attribution.idioma}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-slate-900 dark:text-slate-100">Licencia</dt>
                  <dd class="mt-1 text-slate-600 dark:text-slate-400">{attribution.licencia}</dd>
                </div>
                <div class="sm:col-span-2">
                  <dt class="font-semibold text-slate-900 dark:text-slate-100">Fuente</dt>
                  <dd class="mt-1 text-slate-600 dark:text-slate-400">
                    {sourceUrl ? (
                      <a class="inline-flex items-center gap-1 font-semibold text-brand-cianDark underline decoration-brand-cianClaro underline-offset-4 dark:text-brand-cianClaro" href={sourceUrl} rel="license noopener noreferrer" target="_blank">
                        {attribution.fuente}
                        <ExternalLink class="h-4 w-4" aria-hidden="true" />
                      </a>
                    ) : (
                      attribution.fuente
                    )}
                  </dd>
                </div>
              </dl>
            </article>
          );
        })}
      </div>

      <section class="mt-6 rounded-2xl border border-brand-cianClaro bg-brand-cianClaro/10 p-5 text-sm leading-6 text-slate-900 dark:border-brand-cian/30 dark:bg-brand-cian/10 dark:text-slate-100">
        <h2 class="font-bold">Aviso CC BY 4.0</h2>
        <p class="mt-2">
          El texto Palabra de Dios para ti (spapddpt) se atribuye a eBible.org y se publica bajo Creative Commons
          Attribution 4.0 International (CC BY 4.0). Podés consultar los términos completos en
          <a class="font-semibold underline decoration-brand-cianClaro underline-offset-4" href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener noreferrer" target="_blank"> creativecommons.org/licenses/by/4.0/</a>.
        </p>
      </section>
    </section>
  </main>
</MainLayout>
