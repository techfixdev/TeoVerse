---
import { Search } from '@lucide/astro';
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout title="TeoVerse | Buscar">
  <main class="min-h-screen bg-slate-100 p-4 text-slate-950 dark:bg-slate-950 dark:text-slate-100 sm:p-6">
    <section class="mx-auto max-w-4xl rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900 sm:p-8">
      <a class="text-sm font-semibold text-indigo-600 underline decoration-indigo-200 underline-offset-4 dark:text-indigo-300" href="/">
        Volver al inicio
      </a>

      <div class="mt-6 flex items-start gap-3">
        <span class="rounded-2xl bg-indigo-50 p-3 text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-300">
          <Search class="h-6 w-6" aria-hidden="true" />
        </span>
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">Busqueda biblica</p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight">Buscar en TeoVerse</h1>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
            MVP estático sobre los versículos sembrados de spapddpt Genesis 1. La búsqueda corre en tu navegador desde un JSON generado durante el build.
          </p>
        </div>
      </div>

      <form class="mt-8" role="search">
        <label class="text-sm font-semibold text-slate-800 dark:text-slate-200" for="search-query">Texto a buscar</label>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <input
            id="search-query"
            name="q"
            class="min-h-12 flex-1 rounded-2xl border border-slate-300 bg-white px-4 py-3 text-base outline-none ring-indigo-500 transition focus:ring-2 dark:border-slate-700 dark:bg-slate-950"
            type="search"
            autocomplete="off"
            placeholder="principio, Genesis, spapddpt..."
          />
          <button class="rounded-2xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900" type="submit">
            Buscar
          </button>
        </div>
        <p id="search-help" class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          Busca sin distinguir mayúsculas sobre texto, libro y versión.
        </p>
      </form>

      <section class="mt-8" aria-live="polite" aria-atomic="true">
        <p id="search-status" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Cargando indice de búsqueda...</p>
        <ol id="search-results" class="mt-4 space-y-3"></ol>
      </section>
    </section>
  </main>

  <script>
    type SearchDocument = {
      version: string;
      book: string;
      chapter: number;
      verse: number;
      text: string;
      href: string;
    };

    const form = document.querySelector('form[role="search"]');
    const input = document.querySelector('#search-query');
    const status = document.querySelector('#search-status');
    const results = document.querySelector('#search-results');

    let documents: SearchDocument[] = [];

    function normalize(value: string) {
      return value.toLocaleLowerCase('es');
    }

    function renderMatches(query: string) {
      if (!status || !results) return;

      results.textContent = '';

      const normalizedQuery = normalize(query.trim());
      if (!normalizedQuery) {
        status.textContent = documents.length
          ? `${documents.length} versiculos disponibles. Escribí una búsqueda para empezar.`
          : 'No hay documentos de búsqueda disponibles.';
        return;
      }

      const matches = documents.filter((document) => {
        const haystack = normalize(`${document.version} ${document.book} ${document.text}`);
        return haystack.includes(normalizedQuery);
      });

      status.textContent = matches.length === 1 ? '1 resultado encontrado.' : `${matches.length} resultados encontrados.`;

      for (const match of matches) {
        const item = document.createElement('li');
        item.className = 'rounded-2xl border border-slate-200 p-4 dark:border-slate-800';

        const link = document.createElement('a');
        link.className = 'font-bold text-indigo-700 underline decoration-indigo-200 underline-offset-4 dark:text-indigo-300';
        link.href = match.href;
        link.textContent = `${match.book} ${match.chapter}:${match.verse} (${match.version})`;

        const text = document.createElement('p');
        text.className = 'mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300';
        text.textContent = match.text;

        item.append(link, text);
        results.append(item);
      }
    }

    async function loadSearchIndex() {
      if (!(input instanceof HTMLInputElement) || !status) return;

      try {
        const response = await fetch('/search-index.json');
        if (!response.ok) throw new Error(`Search index request failed with ${response.status}.`);

        const index = await response.json();
        documents = Array.isArray(index.documents) ? index.documents : [];

        const initialQuery = new URLSearchParams(window.location.search).get('q') ?? '';
        input.value = initialQuery;
        renderMatches(initialQuery);
      } catch (error) {
        console.error(error);
        status.textContent = 'No se pudo cargar el índice de búsqueda.';
      }
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(input instanceof HTMLInputElement)) return;

      const query = input.value.trim();
      const url = new URL(window.location.href);
      if (query) {
        url.searchParams.set('q', query);
      } else {
        url.searchParams.delete('q');
      }

      window.history.replaceState({}, '', url);
      renderMatches(query);
    });

    input?.addEventListener('input', () => {
      if (input instanceof HTMLInputElement) renderMatches(input.value);
    });

    loadSearchIndex();
  </script>
</MainLayout>
